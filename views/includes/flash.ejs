<% if(success && success.length){%>
<div  class="alert alert-success" role="alert alert-dismissible fade show col-6 offset-3">
    <%= success %>
    <button type="button" 
    class="btn-close" 
    data-bs-dismiss="alert"
     aria-label="Close"></button>
</div>
<%}%>

<% if(error && error.length){%>
<div  class="alert alert-danger---" role="alert alert-dismissible fade show col-6 offset-3">
    <%= error %>
    <button type="button" 
    class="btn-close" 
    data-bs-dismiss="alert"
     aria-label="Close"></button>
</div>
<%}%>